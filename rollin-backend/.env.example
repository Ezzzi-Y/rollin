# Rollin backend configuration example. Copy to .env and fill in real values.
# MySQL and Redis are external services; never commit real credentials.

HTTP_ADDRESS=:8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rollin
MYSQL_USER=rollin
MYSQL_PASSWORD=
MYSQL_AUTO_CREATE_DATABASE=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Candidate-facing host (offer links, t.xxx.xxx) and the management console host.
# When both run on the same domain, set ADMIN_BASE_URL equal to CANDIDATE_BASE_URL.
CANDIDATE_BASE_URL=https://t.example.edu.cn
ADMIN_BASE_URL=https://admin.example.edu.cn

# 32 bytes base64 (AES-256-GCM). Encrypts SMTP passwords at rest. Generate with:
#   openssl rand -base64 32
SMTP_ENC_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Super admin bootstrap (idempotent; applies only to an empty platform_admin table).
SUPER_ADMIN_NAME=超级管理员
SUPER_ADMIN_EMAIL=root@example.edu.cn
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMe_12345678

# Cookie/session. SESSION_HOURS also backs the platform "sessionHours" parameter.
COOKIE_SECURE=true
SESSION_HOURS=24

# Extra hosts (comma separated) accepted by the CSRF Origin/Referer check besides the
# request Host itself. Empty means "request Host only".
CSRF_ALLOWED_ORIGINS=

# Legacy alias kept for compatibility; prefer SUPER_ADMIN_INITIAL_PASSWORD.
#SUPER_ADMIN_PASSWORD=
# Legacy alias for CANDIDATE_BASE_URL.
#PUBLIC_BASE_URL=

# Login throttling (both scopes): IP+email fixed window, default 5 per 15 minutes
# (04-api-contract.md §1.4). RATE_LIMITED is returned beyond the limit.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
