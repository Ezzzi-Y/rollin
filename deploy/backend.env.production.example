# Rollin production backend environment.
# Copy this file to /etc/rollin/backend.env on the server, then replace every
# REPLACE_* value with the real production setting.
#
# ADMIN_BASE_URL and CANDIDATE_BASE_URL are deliberately omitted here. The
# GitHub Actions backend workflow injects them from repository Secrets into the
# container, and the frontend workflow uses the same Secrets to render Nginx.

HTTP_ADDRESS=:8080

# External MySQL. Use a dedicated application account, never MySQL root.
MYSQL_HOST=REPLACE_EXTERNAL_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=rollin
MYSQL_USER=rollin
MYSQL_PASSWORD=REPLACE_MYSQL_PASSWORD

# External Redis. DB 4 matches the current local configuration; choose a
# dedicated DB number if the Redis service is shared with other applications.
REDIS_HOST=REPLACE_EXTERNAL_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_DB=4

# Required AES-256-GCM key for SMTP passwords stored in MySQL.
# Generate a fresh stable value once and keep it unchanged after deployment:
#   openssl rand -base64 32
SMTP_ENC_KEY=REPLACE_BASE64_32_BYTE_KEY

# Bootstrap account. Only used when platform_admin is empty; it never changes
# an existing account password on later deployments.
SUPER_ADMIN_NAME=REPLACE_ADMIN_NAME
SUPER_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
SUPER_ADMIN_INITIAL_PASSWORD=REPLACE_STRONG_INITIAL_PASSWORD

# Production runs behind HTTPS.
COOKIE_SECURE=true
SESSION_HOURS=24
CSRF_ALLOWED_ORIGINS=

# Login throttling. These values may be omitted to use the same defaults.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15

# Optional SMTP worker timeout; omit to use the 30-second default.
# MAIL_SMTP_TIMEOUT_SECONDS=30
